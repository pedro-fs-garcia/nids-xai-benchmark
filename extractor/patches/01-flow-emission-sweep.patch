+    /**
+     * NIDS: emite os fluxos cujo tempo limite já passou no relógio da captura. Pelas regras do extrator,
+     * nenhum pacote posterior pode mais entrar nesses fluxos. Cada fluxo emitido continua no mapa até o
+     * pacote seguinte do mesmo identificador, para que o fluxo seguinte da mesma conexão TCP herde o
+     * sentido e a duração acumulada, como na emissão original.
+     */
+    public int sweep(long captureClock) {
+        int total = 0;
+        while (!creationOrder.isEmpty()) {
+            Pending head = creationOrder.peekFirst();
+            if ((captureClock - head.flow.getFlowStartTime()) <= flowTimeOut) {
+                break;
+            }
+            creationOrder.pollFirst();
+            if (currentFlows.get(head.key) != head.flow || emittedFlows.contains(head.flow)) {
+                continue;
+            }
+            if (head.flow.getProtocol() == ProtocolEnum.TCP) {
+                long currDuration = head.flow.getCumulativeTcpConnectionDuration();
+                currDuration += head.flow.getFlowDuration();
+                head.flow.setCumulativeTcpConnectionDuration(currDuration);
+            }
+            emittedFlows.add(head.flow);
+            lastEmissionCause = "timeout_sweep";
+            mListener.onFlowGenerated(head.flow);
+            total++;
         }
+        return total;
+    }
+
+    /** NIDS: no fim da captura, emite os fluxos ainda não emitidos, como dumpLabeledCurrentFlow. */
+    public int flush() {
+        int total = 0;
+        for (BasicFlow flow : currentFlows.values()) {
+            if (flow.packetCount() >= 1 && !emittedFlows.contains(flow)) {
+                if (flow.getProtocol() == ProtocolEnum.TCP) {
+                    flow = updateTcpCxnDuration(flow);
+                }
+                emittedFlows.add(flow);
+                lastEmissionCause = "end_of_capture";
+                mListener.onFlowGenerated(flow);
+                total++;
+            }
+        }
+        return total;
+    }
