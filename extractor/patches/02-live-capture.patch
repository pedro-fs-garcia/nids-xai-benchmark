+		// de parada seriam atendidos. No modo não bloqueante, nextEx retorna 0 quando não há pacotes. O tempo
+		// limite continua definindo quanto o kernel espera para entregar um bloco parcial de pacotes.
+		StringBuilder nonBlockError = new StringBuilder();
+		if (pcapReader.setNonBlock(1, nonBlockError) != Pcap.OK) {
+			throw new IllegalStateException("Falha ao ativar o modo não bloqueante em " + device + ": " + nonBlockError);
